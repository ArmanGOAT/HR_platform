# Copy to .env and fill in. .env is in .gitignore and is never committed.

# Postgres
POSTGRES_USER=hr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hr_platform

# MinIO (S3-compatible storage); the password needs at least 8 characters
MINIO_ROOT_USER=hr-minio
MINIO_ROOT_PASSWORD=change-me-please

# Telegram — only for the old collector script telegram_parsing_data.py (my.telegram.org)
TG_API_ID=
TG_API_HASH=
